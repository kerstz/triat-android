<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- EncryptedSharedPreferences keys are device-bound; restoring only the
         ciphertext makes the session store unreadable on the new device. -->
    <exclude domain="sharedpref" path="yt_music_session.xml"/>
    <exclude domain="sharedpref" path="lastfm_private.xml"/>
    <exclude domain="sharedpref" path="lastfm_hint.xml"/>
    <!-- The desktop sync key and device id. A credential: never leaves the phone.
         The tombstones (triat_sync_tombstones.xml) are deliberately NOT excluded,
         so a restore does not bring deleted items back. -->
    <exclude domain="sharedpref" path="triat_sync_pairing.xml"/>
    <!-- A wall-clock deadline is meaningless on another install. -->
    <exclude domain="sharedpref" path="triat_sleep_timer.xml"/>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
