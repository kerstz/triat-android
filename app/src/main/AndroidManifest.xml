<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Metered-network detection for the per-network stream quality settings -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Desktop sync discovery (mDNS on the Wi-Fi). A normal permission, granted
        at install with no prompt, and deliberately not a location one: NsdManager
        does not need location. NsdManager itself does not require this one;
        it is declared so a multicast lock can be taken on a device whose Wi-Fi
        filter drops mDNS replies.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ Live Updates (Live Activities) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".IvorMusicApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.App.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

            <!--
                Android's share sheet. A mime type is the only filter the
                manifest can express, so Koda is offered for any shared text and
                sorts out whether it holds a YouTube link at handling time.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
                "Open with" for YouTube links. Paths are constrained to what the
                app can actually play, so Triat is not offered for channel or
                account URLs it would only fail on. Every link plays as audio in
                the music player: /shorts/, /live/, /embed/ and /v/ carry a
                video id that YouTubeLinkParser resolves like a /watch link.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtu.be" />
                <data android:pathPattern="/.*" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/embed/" />
                <data android:pathPrefix="/v/" />
            </intent-filter>

        </activity>

        <!-- Launcher activity aliases for dynamic app icon switching -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCrimson"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_crimson"
            android:roundIcon="@mipmap/ic_launcher_crimson_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMidnight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_midnight_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityEmerald"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_emerald"
            android:roundIcon="@mipmap/ic_launcher_emerald_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivitySunset"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset"
            android:roundIcon="@mipmap/ic_launcher_sunset_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityOcean"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityBlossom"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blossom"
            android:roundIcon="@mipmap/ic_launcher_blossom_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMonochrome"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:roundIcon="@mipmap/ic_launcher_monochrome_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivitySolar"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_solar"
            android:roundIcon="@mipmap/ic_launcher_solar_round"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc"/>

        <service
            android:name=".service.MusicService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService"/>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!--
            Keeps the process alive while downloads run. dataSync is the correct
            type for user-initiated file transfers; the matching
            FOREGROUND_SERVICE_DATA_SYNC permission is declared above.
        -->
        <service
            android:name=".service.DownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
            Category artwork for the Android Auto browse tree
            (service/AutoArtworkProvider.kt): deterministic tonal tiles served
            as plain PNGs. Exported with no read permission on purpose - the
            car-side image loader cannot decode vector XML, so resource URIs
            fail exactly where this art has to work, while a content URI loads
            everywhere. Static art only, no user data behind it, so there is
            nothing to protect. The authority rides ${applicationId} because
            the debug build carries an applicationIdSuffix.
        -->
        <provider
            android:name=".service.AutoArtworkProvider"
            android:authorities="${applicationId}.autoartwork"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            Quick Settings playback tile. A pure session client: it binds a
            MediaController to MusicService, so the tile's play/pause and its
            state are the same playback the app shows. The BIND_QUICK_SETTINGS
            _TILE permission is the system's own requirement for talking to it;
            exported is mandatory for the same reason.
        -->
        <service
            android:name=".service.PlaybackTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            The home screen widget family. Six providers over one observable
            snapshot (widget/PlayerWidgetHost.kt), all pure session clients like
            the QS tile: none holds a MediaController, and every tap binds a
            throwaway one on the main thread.

            MusicService pushes a redraw on each playback event; a 30-minute
            updatePeriodMillis heartbeat (the platform floor) exists only so a
            widget frozen by an OEM force-kill eventually corrects itself.

            exported="true" is deliberate on every receiver: on stock Android
            the APPWIDGET_UPDATE broadcasts come from system_server, which
            bypasses the export check, so exported="false" worked on Pixels -
            but OEM launchers (HyperOS/MIUI Home notably) talk to provider
            receivers directly, and a non-exported receiver silently drops
            those, which read as "widgets do not work on this phone". The
            intent filter only accepts APPWIDGET_UPDATE and AppWidgetProvider
            ignores non-widget actions, so exporting is safe.

            Listed in picker order - the everyday one first, the two decorative
            ones last.
        -->
        <receiver
            android:name=".widget.PulseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pulse_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulse_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ConsoleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_console_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/console_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.DeckWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_deck_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deck_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.LineupWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lineup_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lineup_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BloomWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_bloom_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bloom_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.OrbitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_orbit_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/orbit_widget_info" />
        </receiver>

    </application>

</manifest>
